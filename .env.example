# ==============================================================================
# DEFCON 2.0 Terminal Registration Environment Configuration
# ==============================================================================

# Application Environment (development | production)
ENVIRONMENT=development
DEBUG=true

# Database Configuration
# Local SQLite fallback for testing: sqlite:///./defcon.db
# PostgreSQL (Default for Docker / Production):
DATABASE_URL=postgresql+psycopg://defcon_user:defcon_secret@localhost:5432/defcon_db

# PostgreSQL Container Credentials (used by Docker Compose)
POSTGRES_USER=defcon_user
POSTGRES_PASSWORD=defcon_secret
POSTGRES_DB=defcon_db
POSTGRES_PORT=5432

# CORS Configuration (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://localhost:80

# Session Security (Generate strong random 64-char strings in production)
SESSION_COOKIE_NAME=defcon_session
SESSION_SECRET=change_this_to_a_secure_random_hex_key_for_production_sessions
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Administrator Portal Credentials & Security
ADMIN_USERNAME=admin
ADMIN_PASSWORD=defcon_warangal_2026
ADMIN_COOKIE_NAME=defcon_admin_token
ADMIN_SECRET=change_this_to_a_secure_random_hex_key_for_admin_signatures

# Event Configuration (Displayed across Terminal and Sidebar)
EVENT_NAME=DEFCON 2.0
EVENT_FORMAT=Attack – Defense
EVENT_DURATION=4 Hours
EVENT_MODE=Team (1 – 4 members)
EVENT_VENUE=NIT Warangal
EVENT_DATE=October 24, 2026

# Rate Limiting
MAX_SUBMISSION_ATTEMPTS=5
SUBMISSION_RATE_LIMIT_WINDOW_SECONDS=60
